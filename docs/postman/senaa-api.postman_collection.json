				{
					"name": "Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"محمد أحمد\",\n  \"email\": \"mohammed@example.com\",\n  \"phone\": \"+970591234567\",\n  \"password\": \"Str0ng!Pass\",\n  \"password_confirmation\": \"Str0ng!Pass\",\n  \"governorate_id\": 1,\n  \"area_id\": 1,\n  \"terms_accepted\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register/customer",
							"host": ["{{base_url}}"],
							"path": ["auth", "register", "customer"]
						},
						"description": "Creates the account with email_verified_at = NULL and sends a 6-digit code (purpose=register) to the email. No token is returned here — call Verify Email next with the code (check storage/logs/laravel.log locally, since MAIL_MAILER=log) to receive the login token. phone accepts +970 or +972; it is normalized to +970XXXXXXXXX before storage."
					},
					"response": [
						{
							"name": "201 Success",
							"originalRequest": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" },
									{ "key": "Accept", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"full_name\": \"محمد أحمد\",\n  \"email\": \"mohammed@example.com\",\n  \"phone\": \"+970591234567\",\n  \"password\": \"Str0ng!Pass\",\n  \"password_confirmation\": \"Str0ng!Pass\",\n  \"governorate_id\": 1,\n  \"area_id\": 1,\n  \"terms_accepted\": true\n}"
								},
								"url": {
									"raw": "{{base_url}}/auth/register/customer",
									"host": ["{{base_url}}"],
									"path": ["auth", "register", "customer"]
								}
							},
							"status": "Created",
							"code": 201,
							"_postman_previewlanguage": "json",
							"header": [
