							],
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"email\": \"m***@example.com\"\n  },\n  \"message\": \"تم إنشاء الحساب بنجاح. تم إرسال رمز التحقق إلى بريدك الإلكتروني.\"\n}"
